generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  password     String
  avatar       String?
  role         Role              @default(USER)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  status       AccountStatus     @default(ACTIVE)
  addresses    Address[]
  cart         Cart?
  favorites    FavoriteProduct[]
  orders       Order[]
  outfits      Outfit[]
  reviews      Review[]
  savedOutfits SavedOutfit[]
  vendor       Vendor?
}

model Vendor {
  id             String    @id @default(cuid())
  location       String
  logo           String?
  description    String?
  userId         String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  address        String
  coverImage     String?
  businessEmail  String?
  facebook       String?
  instagram      String?
  tiktok         String?
  website        String?
  businessName   String
  city           String?
  contactPerson  String?
  county         String?
  email          String?
  isActive       Boolean   @default(true)
  isVerified     Boolean   @default(false)
  phoneNumber    String?
  whatsappNumber String
  slug           String?   @unique
  town           String?
  products       Product[]
  user           User      @relation(fields: [userId], references: [id])
}

model Category {
  id              String            @id @default(cuid())
  name            String            @unique
  slug            String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  image           String?
  ProductCategory ProductCategory[]
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  website     String?
  description String?
  products    Product[]
}

model Product {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  description      String
  price            Float
  gender           Gender
  vendorId         String
  brandId          String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sku              String?            @unique
  featured         Boolean            @default(false)
  status           ProductStatus      @default(DRAFT)
  views            Int                @default(0)
  sales            Int                @default(0)
  averageRating    Float              @default(0)
  reviewCount      Int                @default(0)
  compareAtPrice   Float?
  isBestSeller     Boolean            @default(false)
  isNewArrival     Boolean            @default(false)
  isTrending       Boolean            @default(false)
  stock            Int                @default(0)
  cartItems        CartItem[]
  favorites        FavoriteProduct[]
  orderItems       OrderItem[]
  outfitItems      OutfitItem[]
  brand            Brand              @relation(fields: [brandId], references: [id])
  vendor           Vendor             @relation(fields: [vendorId], references: [id])
  ProductAttribute ProductAttribute[]
  ProductCategory  ProductCategory[]
  ProductFeature   ProductFeature[]
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]

  @@index([vendorId])
  @@index([brandId])
  @@index([status])
  @@index([featured])
}

model ProductImage {
  id           String   @id @default(cuid())
  imageUrl     String
  isPrimary    Boolean  @default(false)
  productId    String
  createdAt    DateTime @default(now())
  altText      String?
  displayOrder Int      @default(0)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isPrimary])
  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

model ProductVariant {
  id             String      @id @default(cuid())
  stock          Int         @default(0)
  sku            String      @unique
  productId      String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  price          Float?
  imageUrl       String?
  colorId        String?
  colorValue     String?
  compareAtPrice Float?
  costPrice      Float?
  isAvailable    Boolean     @default(true)
  sizeId         String?
  sizeValue      String?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  Color          Color?      @relation(fields: [colorId], references: [id])
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  Size           Size?       @relation(fields: [sizeId], references: [id])

  @@index([colorId])
  @@index([productId])
  @@index([sizeId])
}

model Outfit {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  style       String
  coverImage  String?
  creatorId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  isPublic    Boolean       @default(true)
  likes       Int           @default(0)
  occasion    String?
  season      String?
  views       Int           @default(0)
  creator     User          @relation(fields: [creatorId], references: [id])
  items       OutfitItem[]
  savedBy     SavedOutfit[]

  @@index([creatorId])
  @@index([style])
}

model OutfitItem {
  id        String   @id @default(cuid())
  outfitId  String
  productId String
  createdAt DateTime @default(now())
  positionX Float?
  positionY Float?
  scale     Float?   @default(1.0)
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([outfitId, productId])
}

model SavedOutfit {
  id        String   @id @default(cuid())
  userId    String
  outfitId  String
  createdAt DateTime @default(now())
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, outfitId])
}

model FavoriteProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  county     String
  city       String
  area       String
  street     String
  building   String?
  postalCode String?
  landmark   String?
  latitude   Float?
  longitude  Float?
  label      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  addressId     String
  subtotal      Float
  shippingFee   Float
  tax           Float
  discount      Float         @default(0)
  total         Float
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  couponCode    String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  address       Address       @relation(fields: [addressId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  items         OrderItem[]

  @@index([userId])
  @@index([addressId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  productName  String
  productImage String
  variantName  String?
  price        Float
  quantity     Int
  subtotal     Float
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model AppSettings {
  id                    String   @id @default(cuid())
  siteName              String   @default("DressMe")
  tagline               String?
  logoUrl               String?
  logoDarkUrl           String?
  faviconUrl            String?
  heroBannerUrl         String?
  supportEmail          String?
  supportPhone          String?
  whatsappNumber        String?
  facebook              String?
  instagram             String?
  tiktok                String?
  x                     String?
  linkedin              String?
  youtube               String?
  heroTitle             String?
  heroSubtitle          String?
  heroCtaText           String?
  heroCtaLink           String?
  featuredCategorySlug  String?
  featuredBrandSlug     String?
  featuredProductsLimit Int      @default(8)
  trendingProductsLimit Int      @default(8)
  newArrivalsLimit      Int      @default(8)
  bestSellersLimit      Int      @default(8)
  physicalAddress       String?
  businessHours         String?
  currency              String   @default("KES")
  defaultShippingFee    Float    @default(500)
  aboutUs               String?
  privacyPolicy         String?
  termsOfService        String?
  refundPolicy          String?
  shippingPolicy        String?
  siteTitle             String?
  metaDescription       String?
  metaKeywords          String?
  ogImageUrl            String?
  twitterCardType       String?  @default("summary_large_image")
  maintenanceMode       Boolean  @default(false)
  country               String?  @default("Kenya")
  language              String?  @default("en")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MediaItem {
  id        String   @id @default(cuid())
  filename  String
  url       String
  altText   String?
  folder    String?  @default("general")
  mimeType  String?
  size      Int?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attribute {
  id             String           @id
  name           String           @unique
  slug           String           @unique
  displayOrder   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  AttributeValue AttributeValue[]
}

model AttributeValue {
  id               String             @id
  attributeId      String
  value            String
  slug             String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  Attribute        Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  ProductAttribute ProductAttribute[]

  @@unique([attributeId, value])
  @@index([attributeId])
}

model Color {
  id             String           @id
  name           String           @unique
  hexCode        String?
  isActive       Boolean          @default(true)
  displayOrder   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  ProductVariant ProductVariant[]
}

model ProductAttribute {
  productId        String
  attributeValueId String
  AttributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  Product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
  @@index([productId])
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  Category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  Product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])

  @@index([productId])
}

model ProductFeature {
  id           String   @id
  productId    String
  value        String
  icon         String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  Product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Size {
  id             String           @id
  name           String           @unique
  category       SizeCategory     @default(ADULT)
  displayOrder   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  ProductVariant ProductVariant[]
}

enum Role {
  USER
  VENDOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SizeCategory {
  ADULT
  NUMERIC
  FOOTWEAR
  UNIVERSAL
}
